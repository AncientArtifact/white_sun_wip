title: Fiscal Policy
new-page: true
is-card: true
tags: govt_affairs, cabinet
on-arrival: fiscal_policy_timer += 6; week_actions += 1
card-image: img/portraits/LiaoZhongkai.jpg
go-to: fiscal_menu
