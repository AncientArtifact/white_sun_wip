= Internal Factions of the KMT

{!<span class="tooltip-text" title="The Left is interested in radical, transformative policies and cooperation with the CPC.">Left</span>!} strength: [+ left_strength : strength +], dissent: [+ left_dissent : dissent +]

{!<span class="tooltip-text" title="The Center-Left is interested in the transition to democracy and rights for workers.">Center-Left</span>!} strength: [+ center_left_strength : strength +], dissent: [+ center_left_dissent : dissent +]

{!<span class="tooltip-text" title="The Center is a faction of centrist Tridemists led by Sun Yat-sen in the middle.">Center</span>!} strength: [+ center_strength : strength +], dissent: [+ center_dissent : dissent +]

{!<span class="tooltip-text" title="The Right are conservatives, nationalists and anti-commmunists within the party that seek to begin Political Tutelage on their own terms.">Right</span>!} strength: [+ right_strength : strength +], dissent: [+ right_dissent : dissent +]

{!<span class="tooltip-text" title="The Whampoa clique is a faction of newly appointed officers of the Whampoa Military Academy.">Whampoa</span>!} strength: [+ whampoa_strength : strength +], dissent: [+ whampoa_dissent : dissent +]

@paramilitaries
on-arrival: {!
if (Q.nra_strength) {
    Q.nra_strength_2 = Q.nra_strength.toFixed(1);
}
if (Q.red_strength) {
    Q.red_strength_2 = Q.red_strength.toFixed(1);
}
if (Q.bei_strength) {
    Q.bei_strength_2 = Q.bei_strength.toFixed(1);
}
if (Q.feng_strength) {
    Q.feng_strength_2 = Q.feng_strength.toFixed(1);
}
if (Q.gmj_strength) {
    Q.gmj_strength_2 = Q.gmj_strength.toFixed(1);
}
!}

= Militaries

<span style="color: #10186e">National Revolutionary Army</span> Strength: [+ nra_strength_2 +] thousand

<span style="color: #10186e">National Revolutionary Army</span> Militarization: [+ nra_militancy : militancy +]

<span style="color: #9e1515">Chinese Red Army</span> Strength: [+ red_strength_2 +] thousand

<span style="color: #9e1515">Chinese Red Army</span> Militarization: [+ red_militancy : militancy +]

<span style="color: #aba133">Zhili Beiyang Army</span> Strength: [+ bei_strength_2 +] thousand

<span style="color: #aba133">Zhili Beiyang Army</span> Militarization: [+ bei_militancy : militancy +]

<span style="color: #ab881f">Fengtian Army</span> Strength: [+ feng_strength_2 +] thousand

<span style="color: #ab881f">Fengtian Army</span> Militarization: [+ feng_militancy : militancy +]

@polls
on-arrival: {!
Q.pro_tridemist_disp = Math.round(Q.pro-tridemist);
Q.warlordist_disp = Math.round(Q.warlordist);
Q.socialism_disp = Math.round(Q.socialism);
!}

